{
  "expo": {
    "name": "Along",
    "slug": "along",
    "scheme": "along",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAJm7VOQbEPU8pzQWV2H-lcOo0sW9jBqzo"
      },
      "bundleIdentifier": "com.alonghangouts.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAJm7VOQbEPU8pzQWV2H-lcOo0sW9jBqzo"
        }
      },
      "package": "com.alonghangouts.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Along to access your photo library for government ID verification.",
          "cameraPermission": "Allow Along to access your camera to capture your ID and take a selfie for liveness check."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyAJm7VOQbEPU8pzQWV2H-lcOo0sW9jBqzo"
        }
      ]
    ]
  }
}
